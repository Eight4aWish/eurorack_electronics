	(text "CV JACKS AND ADC"
		(exclude_from_sim no)
		(at 20.32 17.78 0)
		(effects
			(font (size 2.5 2.5) (bold yes))
			(justify left top)
		)
		(uuid "8ef0f266-43c6-502c-a9d4-8c9202c4bf9a")
	)
	(text "ADS8688: 8 channels, 16-bit, 1 MΩ inputs with ±10.24 / ±5.12 V ranges set per channel in firmware, OVP ±20 V.\nEvery CV jack is read through 1 kΩ; 100 kΩ holds an unpatched input at 0 V. CV1-6 are bidirectional: a DG412\nswitch (on at logic 1) joins the DAC stage to the jack through another 1 kΩ, so with the switch on the ADC reads\nthe jack itself. The TCA9555 lines have internal pull-ups, so each switch enable has a 4.7 kΩ pull-down that wins\n(≤ 100 µA × 4.7 kΩ = 0.47 V < 0.8 V): every jack starts as an input. Internal 4.096 V reference."
		(exclude_from_sim no)
		(at 20.32 22.86 0)
		(effects
			(font (size 1.5 1.5))
			(justify left top)
		)
		(uuid "f2145dfd-4783-5945-859f-d8972a60c908")
	)
