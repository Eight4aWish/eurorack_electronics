	(text "+5VD: TPS54308 forced-PWM buck, 350 kHz (TPS54202 is a pin- and value-compatible fallback)"
		(exclude_from_sim no)
		(at 20.32 107.95 0)
		(effects
			(font (size 1.5 1.5) (bold yes))
			(justify left top)
		)
		(uuid "4f44d7be-9d0b-5fab-951a-9b78f352323a")
	)
	(text "Vout = 0.596 V × (1 + 15k/2k) = 5.07 V; L and Cout from TI's table for 5 V. Input: own ferrite and 2 × 10 µF, keeping the\n350 kHz input ripple off the ±12 V rail the op-amps share. EN divider 510k/75k: starts at ≈9.2 V, stops at ≈8.1 V,\nso the digital 5 V never runs while the analogue 5 V (L78M05) is down: TI's power-up order for the codec."
		(exclude_from_sim no)
		(at 20.32 113.03 0)
		(effects
			(font (size 1.27 1.27))
			(justify left top)
		)
		(uuid "1f5a65b7-b6a8-55d4-8580-b8be83a0a95c")
	)
