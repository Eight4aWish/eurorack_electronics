	(text "680 Ω minimum load: four 12 V gates push ≈3.4 mA\ninto +3V3D through their clamps; the\nXC6206 cannot sink it (4.85 mA here)."
		(exclude_from_sim no)
		(at 340.36 121.92 0)
		(effects
			(font (size 1.27 1.27))
			(justify left top)
		)
		(uuid "b7bc0cee-57f8-57a2-84f8-a6439491411d")
	)
	(text "MOD_5V: +5VD through a Schottky to Pico VSYS / ESP32-P4 VCC_5V / Teensy VIN"
		(exclude_from_sim no)
		(at 231.14 154.94 0)
		(effects
			(font (size 1.5 1.5) (bold yes))
			(justify left top)
		)
		(uuid "64879209-62d7-5423-8f06-9b4e372614fd")
	)
	(text "Q201 bypasses D203 when JP201 is bridged, for the ESP32-P4, whose regulator needs ≥ 4.5 V at 0.5-0.7 A.\nIts gate follows the Pico/P4 VBUS pin (pin 40): with USB plugged in the FET turns off, as in the Pico 2\ndatasheet's VSYS circuit. Leave JP201 open for a Pico 2 or a Teensy."
		(exclude_from_sim no)
		(at 231.14 158.75 0)
		(effects
			(font (size 1.27 1.27))
			(justify left top)
		)
		(uuid "97a28f43-8278-54ed-aa0b-408e3b1d3988")
	)
