	(text "CV DAC"
		(exclude_from_sim no)
		(at 20.32 17.78 0)
		(effects
			(font (size 2.5 2.5) (bold yes))
			(justify left top)
		)
		(uuid "24f96668-2732-5604-bf7d-2cb049ff7c19")
	)
	(text "DAC8568 grade A: 0-2.5 V from its internal reference (off at power-up; firmware enables it), outputs reset to zero.\nEach stage: non-inverting gain 1 + 30k/10k = 4, offset by OFFSET_REF = 2/3 × VREF through the 10 kΩ:\nVout = 4·Vdac − 3·(2/3)·VREF = −5 V … +5 V. The offset tracks the DAC's own reference, so mid-code is 0 V\nwhatever the reference does. Before the reference is on, OFFSET_REF is 0 V and every stage sits at 0 V.\n±10 V variant (not Rev A): OPA4197 in the same footprint, gain 8, OFFSET_REF = 10/7 V."
		(exclude_from_sim no)
		(at 20.32 22.86 0)
		(effects
			(font (size 1.5 1.5))
			(justify left top)
		)
		(uuid "641fbfe2-59fd-5516-9a2e-190f3a68ae3e")
	)
