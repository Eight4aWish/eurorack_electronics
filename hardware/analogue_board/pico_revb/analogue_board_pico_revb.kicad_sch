	(text "J102: the ESP32-P4's own I2C bus (its camera, display and ES8311 codec;\n2.2 kΩ pull-ups on the module). Reserved on every board: nothing else may use\npins 16 and 17. An extra I2C part can join that bus here."
		(exclude_from_sim no)
		(at 85.09 195.58 0)
		(effects
			(font (size 1.27 1.27))
			(justify left top)
		)
		(uuid "221935ec-bdce-57f1-ac73-5530900f21b5")
	)
