	(text "680 Ω minimum load: four 12 V gates push ≈3.4 mA\ninto +3V3D through their clamps; the\nXC6206 cannot sink it (4.85 mA here)."
		(exclude_from_sim no)
		(at 340.36 121.92 0)
		(effects
			(font (size 1.27 1.27))
			(justify left top)
		)
		(uuid "d207ea62-f89c-56f9-8c03-77e03662776f")
	)
	(text "MOD_5V: +5VD through a Schottky to Pico VSYS / ESP32-P4 VCC_5V"
		(exclude_from_sim no)
		(at 231.14 154.94 0)
		(effects
			(font (size 1.5 1.5) (bold yes))
			(justify left top)
		)
		(uuid "a918f4d3-acb1-5726-9b6c-5c39fa2fbc7e")
	)
	(text "Q201 bypasses D203 when JP201 is bridged, for the ESP32-P4, whose regulator needs ≥ 4.5 V at 0.5-0.7 A.\nIts gate follows the Pico/P4 VBUS pin (pin 40): with USB plugged in the FET turns off, as in the Pico 2\ndatasheet's VSYS circuit. Leave JP201 open for a Pico 2."
		(exclude_from_sim no)
		(at 231.14 158.75 0)
		(effects
			(font (size 1.27 1.27))
			(justify left top)
		)
		(uuid "eceab456-6627-597e-b8ba-67a601660afc")
	)
