	(text "TRS MIDI IN AND OUT"
		(exclude_from_sim no)
		(at 20.32 17.78 0)
		(effects
			(font (size 2.5 2.5) (bold yes))
			(justify left top)
		)
		(uuid "905a850c-1f17-5473-8f9f-1cfbc7b0d1d4")
	)
	(text "MIDI 1.0 over 3.5 mm TRS, Type A (MIDI Association RP-054): tip = current sink (DIN pin 5), ring = current source\n(DIN pin 4), sleeve = shield (DIN pin 2). Electrical values per CA-033 (2014). Uses the two UART-capable spare pins through\nlink holes on J101 (SPARE1-MIDI_TX, SPARE2-MIDI_RX): left open, SPARE1/2 stay plain GPIO. Review: docs/analogue_board_review/midi.md"
		(exclude_from_sim no)
		(at 20.32 22.86 0)
		(effects
			(font (size 1.5 1.5))
			(justify left top)
		)
		(uuid "30db318b-b832-5ce6-8b79-0c92942e8ff3")
	)
	(text "MIDI OUT: 3.3 V UART → 74AHCT1G125 at +5VD → 2 × 100 Ω per leg (1206) → TRS. Idle high = no loop current.\nA mono cable shorting ring to sleeve draws 25 mA from the buck; each 100 Ω sees 64 mW."
		(exclude_from_sim no)
		(at 20.32 45.72 0)
		(effects
			(font (size 1.27 1.27))
			(justify left top)
		)
		(uuid "d5ec5e56-17aa-54dc-a556-4aed3a3407ec")
	)
