	(text "CV JACKS AND ADC"
		(exclude_from_sim no)
		(at 20.32 17.78 0)
		(effects
			(font (size 2.5 2.5) (bold yes))
			(justify left top)
		)
		(uuid "8ef0f266-43c6-502c-a9d4-8c9202c4bf9a")
	)
	(text "ADS8688: 8 channels, 16-bit, 1 MΩ inputs with ±10.24 / ±5.12 V ranges per channel (firmware default ±10.24 V), OVP ±20 V.\nEach CV jack: 15 V TVS at the hole, read through 1 kΩ with 1 nF at the ADC pin (TI's EVM). 100 kΩ to ground, but the\nADC's 1 MΩ returns to an internal bias, so an UNPATCHED input reads ≈ +0.2 V (no jack detect since 2026-10-16).\nCV1-6 are bidirectional: a DG412 switch (on at logic 1) joins the DAC stage through 1 kΩ (1206); with it on the ADC\nreads the jack itself. 4.7 kΩ pull-downs beat the TCA9555's internal pull-ups: every jack starts as an input."
		(exclude_from_sim no)
		(at 20.32 22.86 0)
		(effects
			(font (size 1.5 1.5))
			(justify left top)
		)
		(uuid "f2145dfd-4783-5945-859f-d8972a60c908")
	)
