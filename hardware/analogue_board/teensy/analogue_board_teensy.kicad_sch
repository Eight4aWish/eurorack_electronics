	(text "MIDI: bridge SPARE1-MIDI_TX and SPARE2-MIDI_RX (adjacent holes)\nwith a wire or shunt. Left open, SPARE1/2 are plain GPIO.\nOn a Teensy they are Serial1 (TX1, RX1)."
		(exclude_from_sim no)
		(at 85.09 162.56 0)
		(effects
			(font (size 1.27 1.27))
			(justify left top)
		)
		(uuid "c1b12392-b25a-5edd-9797-a343d334ff20")
	)
